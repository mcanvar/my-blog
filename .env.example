# Names only. Never put real values in this file or anywhere in the repo.
# Set values in the Amplify console (Hosting → Environment variables / Secrets)
# or locally in `.env.local` (gitignored).

# --- Next.js (Amplify Hosting → Environment variables) ---
# Public base URL of this deployment. Production: https://mcanvar.dev
NEXT_PUBLIC_SITE_URL=
# reCAPTCHA (Google Cloud) score-based site key. Public by design, but kept out of the repo.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Search engine verification tokens (optional)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# IndexNow key (written to .env.production during the Amplify build, see amplify.yml)
INDEXNOW_KEY=

# --- Local development only ---
# `fixtures` = run the site and admin with in-memory sample data, no AWS needed.
BLOG_DATA_SOURCE=

# --- Amplify backend build (Amplify Hosting → Environment variables, or your shell for sandbox) ---
# If set, this address is subscribed to new-comment notifications (SNS email).
ADMIN_NOTIFY_EMAIL=

# --- Amplify secrets (NOT env vars): set with `npx ampx sandbox secret set <NAME>`
# or Amplify console → Hosting → Secrets ---
# RECAPTCHA_SITE_KEY
# RECAPTCHA_PROJECT_ID
# RECAPTCHA_API_KEY
# IP_HASH_SALT
