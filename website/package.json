{
  "name": "my-blog",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "ensure-outputs": "node scripts/ensure-amplify-outputs.mjs",
    "predev": "npm run ensure-outputs",
    "dev": "next dev",
    "dev:fixtures": "npm run ensure-outputs && BLOG_DATA_SOURCE=fixtures next dev",
    "prebuild": "npm run ensure-outputs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run ensure-outputs",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p amplify/tsconfig.json",
    "pretest": "npm run ensure-outputs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sandbox": "ampx sandbox",
    "migrate": "tsx scripts/migrate-from-gen1.ts",
    "verify": "npm run ensure-outputs && node scripts/verify.mjs",
    "verify:cloud": "npm run ensure-outputs && node scripts/verify.mjs --cloud"
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.8.1",
    "@aws-amplify/ui-react": "^6.15.7",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/markdown": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@tiptap/suggestion": "^3.32.1",
    "aws-amplify": "^6.22.2",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-appsync/utils": "^2.1.1",
    "@aws-sdk/client-dynamodb": "^3.1159.0",
    "@aws-sdk/client-sns": "^3.1159.0",
    "@aws-sdk/lib-dynamodb": "^3.1159.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/aws-lambda": "^8.10.164",
    "@types/github-slugger": "^1.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "aws-cdk-lib": "^2.268.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "description": "Mevlüt Canvar personal blog — Next.js 16 + Amplify Gen 2",
  "engines": {
    "node": ">=22"
  }
}
