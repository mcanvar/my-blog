# Names only. Never put real values in this file or anywhere in the repo.
# Set values in the Amplify console (Hosting → Environment variables / Secrets)
# or locally in `.env.local` (gitignored).

# --- Next.js (Amplify Hosting → Environment variables) ---
# Public base URL of this deployment. Production: https://mcanvar.dev
NEXT_PUBLIC_SITE_URL=
# reCAPTCHA (Google Cloud) score-based site key. Public by design, but kept out of the repo.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Search engine verification tokens (optional)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# IndexNow key (written to .env.production during the Amplify build, see amplify.yml)
INDEXNOW_KEY=
# This deployment's origin, per branch (production: https://mcanvar.dev; locally with a sandbox:
# http://localhost:3000). Turns on admin sign-in with HttpOnly session cookies (also written to
# .env.production by amplify.yml).
AMPLIFY_APP_ORIGIN=

# --- npm run verify:cloud only ---
# Amplify app id (Amplify console → App settings → General).
AMPLIFY_APP_ID=

# --- Local development only ---
# `fixtures` = run the site and admin with in-memory sample data, no AWS needed.
BLOG_DATA_SOURCE=

# --- Amplify backend build (Amplify Hosting → Environment variables, or your shell for sandbox) ---
# If set, this address is subscribed to new-comment notifications (SNS email).
ADMIN_NOTIFY_EMAIL=
# Custom domain for media on the production branch (e.g. cdn.mcanvar.dev) and the Route 53
# hosted zone id of its parent domain. Leave empty to serve media from the *.cloudfront.net name.
MEDIA_DOMAIN=
MEDIA_HOSTED_ZONE_ID=

# --- Amplify secrets (NOT env vars): set with `npx ampx sandbox secret set <NAME>`
# or Amplify console → Hosting → Secrets ---
# RECAPTCHA_SITE_KEY     the reCAPTCHA key, 6L…
# RECAPTCHA_PROJECT_ID   the Google Cloud project ID (not a key)
# RECAPTCHA_API_KEY      a Google Cloud API key, AIza… (not the reCAPTCHA secret key)
# IP_HASH_SALT           at least 32 characters, e.g. `openssl rand -hex 32`
